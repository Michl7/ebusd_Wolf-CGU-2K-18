{#- Template sensor "Boiler last error" - newest entry of the error history with an approximate time.
    The boiler stores the operating hour, not a date: time = now - (OperatingHours - error hour), +-1 h.
    Needs custom_templates/wolf_ebus.jinja. -#}
{% from 'wolf_ebus.jinja' import error_text %}
{%- set code = states('sensor.ebusd_boiler_errorhistorylaststatus_code') | int(-1) -%}
{%- set h_error = states('sensor.ebusd_boiler_errorhistorylasthours') | int(-1) -%}
{%- set h_now = states('sensor.ebusd_boiler_operatinghours') | int(-1) -%}
{%- if code > 0 and h_error > 0 and h_now >= h_error -%}
{%- set ago = h_now - h_error -%}
{%- set t = now() - timedelta(hours=ago) -%}
Error {{ code }}: {{ error_text(code) }} – about {{ ago }} h ago ({{ t.strftime('%Y-%m-%d') }} ~{{ t.strftime('%H') }}:00 ±1 h)
{%- elif code == 0 -%}No entry{%- else -%}Unknown{%- endif -%}
